-- Функции для телепортирующей ходьбы
local function getHum()
    local character = game:GetService("Players").LocalPlayer.Character
    if character then
        return character:FindFirstChildOfClass("Humanoid")
    end
    return nil
end

local function getChar()
    return game:GetService("Players").LocalPlayer.Character
end

-- Функция для форматирования скорости до десятых
local function formatSpeed(speed)
    if speed % 1 == 0 then
        return string.format("%d", speed)
    else
        return string.format("%.1f", speed)
    end
end

local function updateStatus()
    local statusText = TPWalk and "ON" or "OFF"
    local statusColor = TPWalk and Color3.fromRGB(50, 180, 50) or Color3.fromRGB(180, 50, 50) -- ON зеленый, OFF красный
    
    ToggleButton.BackgroundColor3 = statusColor
    ToggleButton.Text = statusText
    StatusLabel.Text = string.format("%s | Speed: %s", statusText, formatSpeed(currentSpeed))
end

local function stopTPWalk()
    if TPWalk then
        TPWalk = false
        if TPWalkingConnection then
            TPWalkingConnection:Disconnect()
            TPWalkingConnection = nil
        end
        updateStatus()
    end
end

local function startTPWalk(speed)
    -- Останавливаем текущий TPWalk если он активен
    if TPWalk then
        stopTPWalk()
        return
    end
    
    -- Устанавливаем новую скорость
    currentSpeed = tonumber(speed) or 1.0
    SpeedBox.Text = formatSpeed(currentSpeed)
    
    -- Включаем TPWalk
    TPWalk = true
    
    TPWalkingConnection = game:GetService("RunService").Stepped:Connect(function(_, deltaTime)
        if TPWalk then
            local humanoid = getHum()
            if humanoid and humanoid.MoveDirection.Magnitude > 0 then
                local moveDirection = humanoid.MoveDirection
                local translation = moveDirection * currentSpeed * deltaTime * 10
                local character = getChar()
                if character then
                    character:TranslateBy(translation)
                end
            end
        end
    end)
    
    updateStatus()
end

-- Функция для применения скорости (без перезапуска TPWalk)
local function applySpeed(speed)
    local newSpeed = tonumber(speed)
    if newSpeed and newSpeed > 0 and newSpeed <= 500 then
        currentSpeed = newSpeed
        SpeedBox.Text = formatSpeed(currentSpeed)
        
        if TPWalk then
            -- Если TPWalk активен, перезапускаем с новой скоростью
            stopTPWalk()
            startTPWalk(currentSpeed)
        else
            updateStatus()
        end
    end
end

-- Обработчики событий
ToggleButton.MouseButton1Click:Connect(function()
    if TPWalk then
        stopTPWalk()
    else
        local speed = tonumber(SpeedBox.Text) or currentSpeed
        startTPWalk(speed)
    end
end)

CloseButton.MouseButton1Click:Connect(function()
    -- Выключаем TPWalk перед закрытием
    stopTPWalk()
    ScreenGui:Destroy()
end)

-- Валидация ввода и обновление скорости
SpeedBox.FocusLost:Connect(function()
    local text = SpeedBox.Text
    if text == "" then
        SpeedBox.Text = formatSpeed(currentSpeed)
    else
        local num = tonumber(text)
        if not num or num <= 0 then
            SpeedBox.Text = formatSpeed(currentSpeed)
        else
            -- Ограничиваем максимальную скорость
            if num > 500 then num = 500 end
            applySpeed(num)
        end
    end
end)

-- Также обновляем скорость при нажатии Enter
